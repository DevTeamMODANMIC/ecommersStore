{
  "name": "modernstore",
  "version": "2.0.0",
  "description": "A modern, component-based eCommerce website with advanced performance optimizations",
  "main": "src/scripts/app.js",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "serve": "python -m http.server 8000",
    "lint": "eslint src --ext .js",
    "lint:fix": "eslint src --ext .js --fix",
    "format": "prettier --write \"src/**/*.{js,css,html}\"",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "analyze": "vite-bundle-analyzer",
    "lighthouse": "lighthouse http://localhost:8000 --output=html --output-path=./reports/lighthouse.html",
    "performance": "node scripts/performance-audit.js",
    "optimize-images": "node scripts/optimize-images.js",
    "clean": "rimraf dist reports",
    "deploy": "npm run build && npm run lighthouse"
  },
  "keywords": [
    "ecommerce",
    "modern",
    "performance",
    "components",
    "vanilla-js",
    "responsive",
    "accessibility"
  ],
  "author": "RUACH Productions",
  "license": "MIT",
  "devDependencies": {
    "@vitejs/plugin-legacy": "^4.1.1",
    "autoprefixer": "^10.4.16",
    "cssnano": "^6.0.1",
    "eslint": "^8.52.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.29.0",
    "lighthouse": "^11.3.0",
    "postcss": "^8.4.31",
    "prettier": "^3.0.3",
    "rimraf": "^5.0.5",
    "rollup-plugin-visualizer": "^5.9.2",
    "sharp": "^0.32.6",
    "terser": "^5.24.0",
    "vite": "^4.5.0",
    "vite-bundle-analyzer": "^0.7.0",
    "vite-plugin-html": "^3.2.0",
    "vite-plugin-pwa": "^0.16.7",
    "vitest": "^0.34.6",
    "workbox-window": "^7.0.0"
  },
  "dependencies": {
    "intersection-observer": "^0.12.2"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ruach-productions/modernstore.git"
  },
  "bugs": {
    "url": "https://github.com/ruach-productions/modernstore/issues"
  },
  "homepage": "https://modernstore.ruachproductions.com"
}